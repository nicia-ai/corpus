{
  "name": "@nicia-ai/corpus",
  "version": "0.1.0",
  "private": true,
  "description": "Corpus — a Git-free canonical markdown context store for teams: documents + agent collections served to agents over MCP, on Cloudflare Workers/D1/Durable Objects.",
  "license": "Apache-2.0",
  "author": "Nicia AI, Inc.",
  "homepage": "https://github.com/nicia-ai/corpus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicia-ai/corpus.git"
  },
  "bugs": {
    "url": "https://github.com/nicia-ai/corpus/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-context",
    "markdown",
    "cloudflare-workers",
    "durable-objects",
    "tanstack-start",
    "better-auth",
    "team-knowledge"
  ],
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./app": "./src/api.ts",
    "./project-store": "./src/project-store.ts",
    "./entitlements": "./src/control/entitlements.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:do-migrations && pnpm check:event-log-migrations && pnpm test && pnpm build",
    "check:fix": "pnpm format && pnpm lint:fix && pnpm check",
    "verify": "tsx scripts/verify.ts",
    "corpus": "tsx cli/corpus.ts",
    "postinstall": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "types": "wrangler types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
    "test:watch": "vitest",
    "build": "vite build && pnpm cli:build && pnpm cli:check",
    "cli:build": "node -e \"require('node:fs').rmSync('cli/dist',{recursive:true,force:true})\" && tsc -p cli/tsconfig.json",
    "cli:check": "tsx scripts/check-cli-package.ts",
    "auth:schema": "auth generate --config src/control/auth.cli.ts --output src/control/schema/better-auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:generate:do": "drizzle-kit generate --config drizzle.do.config.ts && tsx scripts/bundle-do-migrations.ts",
    "db:generate:event-log": "drizzle-kit generate --config drizzle.event-log.config.ts && tsx scripts/bundle-event-log-migrations.ts",
    "check:do-migrations": "tsx scripts/check-do-migrations.ts",
    "check:event-log-migrations": "tsx scripts/check-event-log-migrations.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.2",
    "@better-auth/oauth-provider": "^1.7.2",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "@nicia-ai/prose-diff": "^0.2.0",
    "@nicia-ai/typegraph": "^0.56.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "lucide-react": "^1.39.0",
    "posthog-js": "^1.424.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "auth": "^1.7.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typegraph-prev": "npm:@nicia-ai/typegraph@0.54.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
