{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corpus",
  "main": "src/server.ts",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "logs": { "enabled": true } },
  "dev": { "port": 8787 },
  // Data plane: one ProjectStore instance per Project (TypeGraph +
  // Drizzle co-located so the save path commits as one
  // `ctx.storage.transaction`). Plus one EventLogStore per Project
  // with its OWN SQLite for the append-only instrumentation event
  // stream — separate storage budget so durable events never compete
  // with canonical documents, corpuss, and blobs.
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_STORE", "class_name": "ProjectStore" },
      { "name": "EVENT_LOG_STORE", "class_name": "EventLogStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectStore"] },
    { "tag": "v2", "new_sqlite_classes": ["EventLogStore"] },
  ],
  // Low-frequency control-plane + data-plane retention sweep (the
  // `scheduled` handler in src/server.ts). Hourly: dead-row GC, not
  // latency-sensitive. Self-hosters inherit GC by default.
  "triggers": { "crons": ["0 * * * *"] },
  // Control plane: Better Auth + organization + project + membership in D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corpus-control",
      "database_id": "PLACEHOLDER_RUN_wrangler_d1_create",
      "migrations_dir": "./drizzle",
    },
  ],
  // Optional outbound invite email:
  // - Resend: set EMAIL_FROM + RESEND_API_KEY.
  // - Cloudflare Email Service: add "send_email": [{ "name": "EMAIL" }]
  //   after configuring Email Service, and set EMAIL_FROM.
  // Leaving email unset keeps invite links copy-only.
  // Dev-only. Production sets BETTER_AUTH_SECRET via `wrangler secret put`.
  "vars": {
    "BETTER_AUTH_SECRET": "dev-only-secret-change-me-min-32-chars-long",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  // Optional Git mirror (see docs/git-mirror.md). The default config above
  // has NO Artifacts binding, so the mirror is off — what self-hosters on a
  // plan without Artifacts get. Production opts in by adding the same
  // "artifacts" entry to the top level with its own namespace.
  //
  //
  // Optional file storage (see docs/files.md), the same way: the default
  // config above has NO `FILES` R2 binding, so uploads are off and the editor
  // hides its upload affordances. A deployment opts in by adding
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "<its bucket>" }] to
  // its top level. It is not declared at the top level here because a
  // `wrangler deploy` would then fail for anyone who has not created the
  // bucket.
  //
  // The `mirror` environment is what the test suite's `mirror` project runs
  // against (vite.config.ts): the local Artifacts simulator, which needs Git
  // 2.32+ on PATH. `pnpm dev` cannot use it — the Cloudflare Vite plugin
  // (1.x) does not run the simulator yet. The `files` environment is what
  // the `files` project runs against: a local R2 bucket. Non-inheritable
  // bindings must be repeated in each; keep them in step with the top level.
  "env": {
    "mirror": {
      "durable_objects": {
        "bindings": [
          { "name": "PROJECT_STORE", "class_name": "ProjectStore" },
          { "name": "EVENT_LOG_STORE", "class_name": "EventLogStore" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "corpus-control",
          "database_id": "PLACEHOLDER_RUN_wrangler_d1_create",
          "migrations_dir": "./drizzle",
        },
      ],
      "artifacts": [
        { "binding": "ARTIFACTS", "namespace": "corpus-dev", "remote": false },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "corpus-files-dev" }],
      "vars": {
        "BETTER_AUTH_SECRET": "dev-only-secret-change-me-min-32-chars-long",
        "BETTER_AUTH_URL": "http://localhost:8787",
      },
    },
    "files": {
      "durable_objects": {
        "bindings": [
          { "name": "PROJECT_STORE", "class_name": "ProjectStore" },
          { "name": "EVENT_LOG_STORE", "class_name": "EventLogStore" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "corpus-control",
          "database_id": "PLACEHOLDER_RUN_wrangler_d1_create",
          "migrations_dir": "./drizzle",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "corpus-files-dev" }],
      "vars": {
        "BETTER_AUTH_SECRET": "dev-only-secret-change-me-min-32-chars-long",
        "BETTER_AUTH_URL": "http://localhost:8787",
      },
    },
  },
}
